pragma solidity ^0.8.34;

/**
 * @dev The salt-0 CREATE2 address of {GUARD_BOOTSTRAP_INITCODE}, the same on every chain. The guard
 *      proxy was born pointing at it, so it is part of the guard's address.
 */
address constant GUARD_BOOTSTRAP = 0x0B333102893EA8902dBea5005251F9092e409b3b;

/**
 * @dev The exact creation code of the {BittyV1GuardBootstrap} the live guard was born with, pinned
 *      rather than compiled. Solc appends a hash of every source file's exact text to the bytecode,
 *      so a rebuild from a tree that differs only in a comment yields a different bootstrap address,
 *      a different proxy init code, and so a different guard address. The deploy that produced the
 *      live guard was built from a working tree no commit reproduces, so its bytes are kept here.
 *
 *      Only the metadata is frozen: the code itself is held to the source by
 *      `test/local/GuardBootstrapPin.t.sol`, which compares the two with the metadata stripped.
 */
bytes constant GUARD_BOOTSTRAP_INITCODE =
    hex"";

/**
 * @dev The exact {ERC1967Proxy} creation code the live guard was born with, pinned for the same reason
 *      as the bootstrap: its metadata embeds the compiler settings (remappings, EVM version), which
 *      differ between forge versions, so a compiled proxy moves the guard's address with the toolchain.
 *      Held to the source by `test/local/GuardBootstrapPin.t.sol`, metadata stripped.
 */
bytes constant GUARD_PROXY_CREATIONCODE =
    hex"";
